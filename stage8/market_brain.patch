+def _prepare_hourly_segments(rows):
+    """Validate hourly OHLCV rows, deduplicate timestamps and split at gaps.
+
+    Input rows use the archive layout (symbol, t_ms, open, high, low, close,
+    volume). No labels are allowed to look across a missing or malformed hour.
+    Conflicting duplicate timestamps are discarded as a group; exact duplicates
+    are safely collapsed to one candle.
+    """
+    valid = []
+    invalid_rows = 0
+    by_timestamp = defaultdict(list)
+    for row in rows:
+        try:
+            raw_t = float(row[1])
+            values = [float(row[i]) for i in range(2, 7)]
+            if (not raw_t.is_integer() or raw_t <= 0
+                    or any(not math.isfinite(v) for v in values)):
+                raise ValueError('invalid timestamp or non-finite OHLCV')
+            ts = int(raw_t)
+            op, high, low, close, volume = values
+            if (min(op, high, low, close) <= 0 or volume < 0
+                    or high < max(op, close, low) or low > min(op, close, high)):
+                raise ValueError('invalid OHLCV bounds')
+            normalized = (row[0], ts, op, high, low, close, volume)
+            by_timestamp[ts].append(normalized)
+        except (TypeError, ValueError, IndexError, OverflowError):
+            invalid_rows += 1
+
+    duplicate_groups = 0
+    for ts, candidates in by_timestamp.items():
+        if len(candidates) > 1:
+            # Identical duplicate rows carry no additional information.
+            first = candidates[0]
+            if all(tuple(c[2:]) == tuple(first[2:]) for c in candidates[1:]):
+                duplicate_groups += 1
+                valid.append(first)
+            else:
+                duplicate_groups += 1
+                invalid_rows += len(candidates)
+            continue
+        valid.append(candidates[0])
+
+    valid.sort(key=lambda r: int(r[1]))
+    segments = []
+    current = []
+    gap_breaks = 0
+    for row in valid:
+        if current and int(row[1]) - int(current[-1][1]) != 3_600_000:
+            segments.append(current)
+            current = []
+            gap_breaks += 1
+        current.append(row)
+    if current:
+        segments.append(current)
+    return segments, {
+        'invalid_rows': invalid_rows,
+        'duplicate_timestamp_groups': duplicate_groups,
+        'gap_breaks': gap_breaks,
+        'segments': len(segments),
+        'valid_candles': sum(len(segment) for segment in segments),
+    }
 
 
