# Caddy v2: automatic HTTPS + Basic Authentication + loopback-only upstream.
{$TRADING_AI_DOMAIN} {
    encode zstd gzip
    basic_auth {
        {$TRADING_AI_MOBILE_USER} {$TRADING_AI_MOBILE_PASSWORD_HASH}
    }
    reverse_proxy 127.0.0.1:8765 {
        header_up Host 127.0.0.1:8765
        header_up -Origin
        header_up -Sec-Fetch-Site
    }
}
