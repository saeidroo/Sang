+
+
+
+def test_cross_timeframe_recall_is_opt_in_and_preserves_source_timeframe(tmp_path, monkeypatch):
+    monkeypatch.setattr(knowledge_bus, '_db_path', lambda: tmp_path / 'knowledge.sqlite3')
+    _record(source='scout', timeframe='1h', observed_at=1_800_000_001,
+            payload={'origin': 'hourly'})
+    _record(source='price_action_learning', timeframe='15m', observed_at=1_800_000_002,
+            payload={'origin': 'quarter_hour'})
+
+    strict = knowledge_bus.recall_knowledge(
+        'BTCUSDT', market='spot', timeframe='15m', max_age_seconds=None)
+    assert [row['timeframe'] for row in strict] == ['15m']
+
+    shared = knowledge_bus.recall_knowledge(
+        'BTCUSDT', market='spot', timeframe='15m', include_other_timeframes=True,
+        max_age_seconds=None)
+    assert {row['timeframe'] for row in shared} == {'1h', '15m'}
+    assert {row['payload']['origin'] for row in shared} == {'hourly', 'quarter_hour'}
