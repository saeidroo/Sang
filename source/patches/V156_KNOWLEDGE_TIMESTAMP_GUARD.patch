+def test_future_timestamp_cannot_pin_evidence_or_block_valid_updates(tmp_path, monkeypatch):
+    monkeypatch.setattr(knowledge_bus, '_db_path', lambda: tmp_path / 'knowledge.sqlite3')
+    now = 1_800_000_100.0
+    monkeypatch.setattr(knowledge_bus.time, 'time', lambda: now)
+
+    rejected = _record(source='clock_skewed', observed_at=now + 301,
+                       payload={'version': 'future'})
+    assert rejected['stored'] is False
+    assert rejected['reason'] == 'observed_at_in_future'
+    assert knowledge_bus.knowledge_status()['records'] == 0
+
+    clamped = _record(source='slight_skew', observed_at=now + 30,
+                      payload={'version': 'slight_future'})
+    assert clamped['stored'] is True
+    assert clamped['observed_at'] == now
+
+    valid = _record(source='clock_skewed', observed_at=now,
+                    payload={'version': 'valid'})
+    assert valid['stored'] is True
+    rows = knowledge_bus.recall_knowledge(
+        'BTCUSDT', market='spot', timeframe='1h', max_age_seconds=60)
+    assert {row['source_brain'] for row in rows} == {'clock_skewed', 'slight_skew'}
+    assert next(row for row in rows if row['source_brain'] == 'clock_skewed')['payload']['version'] == 'valid'
