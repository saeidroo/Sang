+def test_historical_validation_evidence_uses_validation_time_for_freshness(tmp_path, monkeypatch):
+    from backend import price_action_learning as learning
+    db = tmp_path / "old-candles.sqlite3"
+    con = sqlite3.connect(db)
+    con.execute("CREATE TABLE candles (symbol TEXT,timeframe TEXT,t INTEGER,open REAL,high REAL,low REAL,close REAL,volume REAL)")
+    con.executemany("INSERT INTO candles VALUES (?,?,?,?,?,?,?,?)",
+                    [("BTCUSDT", "1h", *row) for row in _rows_with_engulfings()])
+    con.commit()
+    con.close()
+
+    validated_at = 1_800_000_000.0
+    monkeypatch.setattr(learning.time, "time", lambda: validated_at)
+    monkeypatch.setattr(knowledge_bus, "_db_path", lambda: tmp_path / "knowledge.sqlite3")
+    result = learning.scan_price_action_archive(
+        timeframe="1h", db_path=db, min_samples=8, publish=True)
+    assert result["status"] == "completed"
+
+    recent = knowledge_bus.recall_knowledge(
+        "BTCUSDT", market="any", timeframe="15m", include_other_timeframes=True,
+        max_age_seconds=7 * 24 * 3600)
+    record = next(x for x in recent if x["source_brain"] == "price_action_validation")
+    assert record["observed_at"] == validated_at
+    assert record["payload"]["validated_at"] == validated_at
+    assert record["payload"]["source_data_through"] < validated_at - 7 * 24 * 3600


