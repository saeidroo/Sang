--- /dev/null
+++ b/tests/test_v23_0_156_processor_heartbeat.py
@@ -0,0 +1,76 @@
+"""Processor liveness is reported separately from stored/evidence freshness."""
+
+import time
+
+
+def test_market_brain_reports_worker_and_heartbeat_separately():
+    from backend import market_brain
+
+    old_worker = market_brain._STARTUP_WORKER
+    old_state = dict(market_brain._STARTUP_STATE)
+    try:
+        class Worker:
+            def is_alive(self):
+                return True
+
+        market_brain._STARTUP_WORKER = Worker()
+        market_brain._STARTUP_STATE.update(heartbeat_ts=time.time(), worker_finished_ts=None)
+        status = market_brain.historical_learning_status()
+        assert status['worker_alive'] is True
+        assert status['processor_state'] == 'active'
+        assert status['heartbeat_stale'] is False
+        market_brain._STARTUP_STATE['heartbeat_ts'] = time.time() - 700
+        status = market_brain.historical_learning_status()
+        assert status['processor_state'] == 'stale'
+        assert status['heartbeat_stale'] is True
+    finally:
+        market_brain._STARTUP_WORKER = old_worker
+        market_brain._STARTUP_STATE.clear()
+        market_brain._STARTUP_STATE.update(old_state)
+
+
+def test_backfill_status_reports_real_worker_liveness():
+    from backend import historical
+
+    old_worker = historical._WORKER
+    old_status = dict(historical._STATUS)
+    try:
+        class Worker:
+            def is_alive(self):
+                return True
+
+        historical._WORKER = Worker()
+        historical._STATUS.update(heartbeat_ts=time.time(), worker_finished_ts=None)
+        status = historical.backfill_status()
+        assert status['worker_alive'] is True
+        assert status['processor_state'] == 'active'
+        historical._STATUS['heartbeat_ts'] = time.time() - 700
+        status = historical.backfill_status()
+        assert status['processor_state'] == 'stale'
+    finally:
+        historical._WORKER = old_worker
+        historical._STATUS.clear()
+        historical._STATUS.update(old_status)
+
+
+def test_scout_reports_loop_liveness_without_claiming_scan_is_running():
+    from backend import scout
+
+    old_state = dict(scout._STATE)
+    try:
+        class Worker:
+            def is_alive(self):
+                return True
+
+        scout._STATE.update(thread=Worker(), running=False, heartbeat_ts=time.time(),
+                            worker_finished_ts=None)
+        status = scout.get_state()
+        assert status['worker_alive'] is True
+        assert status['processor_state'] == 'active'
+        assert status['running'] is False
+        scout._STATE['heartbeat_ts'] = time.time() - 700
+        status = scout.get_state()
+        assert status['processor_state'] == 'stale'
+    finally:
+        scout._STATE.clear()
+        scout._STATE.update(old_state)
