 def price_action_archive_validation_status() -> dict:
     """Return current validator liveness and counters without triggering work."""
     from copy import deepcopy
+    import time
     with _PA_AUDIT_LOCK:
-        return deepcopy(_PA_AUDIT_STATE)
+        state = deepcopy(_PA_AUDIT_STATE)
+        thread = _PA_AUDIT_THREAD
+        alive = bool(thread is not None and thread.is_alive())
+    now = time.time()
+    heartbeat = _finite(state.get("heartbeat_at"))
+    age = max(0.0, now - heartbeat) if heartbeat is not None else None
+    running = state.get("status") in {"starting", "running"}
+    stale = bool(running and alive and age is not None
+                 and age > _PA_HEARTBEAT_STALE_AFTER_SECONDS)
+    if stale:
+        liveness = "stale"
+    elif running and alive:
+        liveness = "active"
+    elif running and not alive:
+        liveness = "worker_exited_unexpectedly"
+    elif state.get("status") in {"completed", "blocked", "error"}:
+        liveness = "finished"
+    else:
+        liveness = "idle"
+    state.update({"worker_alive": alive, "heartbeat_age_seconds": round(age, 2) if age is not None else None,
+                  "heartbeat_stale_after_seconds": _PA_HEARTBEAT_STALE_AFTER_SECONDS,
+                  "heartbeat_stale": stale, "liveness": liveness,
+                  "real_orders_enabled": False, "signal_or_risk_effect": False})
+    return state
 
 
