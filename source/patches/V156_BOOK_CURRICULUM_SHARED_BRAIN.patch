+def test_book_curriculum_is_shared_as_advisory_training():
+    frame = pd.DataFrame([
+        {"open": 100, "high": 105, "low": 95, "close": 101},
+        {"open": 97, "high": 104, "low": 96, "close": 103},
+    ])
+    packet = build_price_action_packet(candles=frame)
+    curriculum = packet["book_curriculum"]
+    assert curriculum["version"] == "PRICE_ACTION_BOOK_CURRICULUM_V1"
+    assert {lesson["source"] for lesson in curriculum["lessons"]} == {
+        "John J. Murphy", "Steve Nison", "Adam Grimes"
+    }
+    assert len(curriculum["shared_decision_protocol"]) == 5
+    assert curriculum["validation_gate"]["may_change_signal_score_risk"] is False
+    assert packet["signal_or_risk_effect"] is False
